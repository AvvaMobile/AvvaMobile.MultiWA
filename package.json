{
  "name": "multiwa",
  "productName": "MultiWA",
  "version": "0.1.0",
  "private": true,
  "description": "Several WhatsApp Web accounts on one computer, one per tab.",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "electron-vite build && node scripts/dev-bundle.cjs && \"./.dev/MultiWA.app/Contents/MacOS/Electron\" .",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "author": "Avva Mobile",
  "homepage": "https://github.com/AvvaMobile/MultiWA",
  "repository": { "type": "git", "url": "https://github.com/AvvaMobile/MultiWA.git" },
  "license": "MIT"
}
